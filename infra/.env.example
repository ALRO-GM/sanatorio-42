# Variables de producción para `docker compose`. Copia a `.env` (modo 600) y
# rellena. Todas están explicadas en apps/api/.env.example; aquí solo van las
# que cambian en producción.

# Dominio público, sin https://. Lo usa Caddy para el certificado.
DOMAIN=sanatorio.example.org

# Imagen de la app. Vacío = se construye en la propia máquina
# (`docker compose up -d --build`). Si la publica el workflow de despliegue:
#   APP_IMAGE=ghcr.io/<usuario>/<repositorio>:latest
APP_IMAGE=

# --- App de 42 ---------------------------------------------------------------
FORTY_TWO_UID=
FORTY_TWO_SECRET=
# Tiene que estar registrada tal cual en el panel de la app de 42.
FORTY_TWO_REDIRECT_URI=https://sanatorio.example.org/api/auth/callback
FORTY_TWO_USER_AGENT=sanatorio-42/1.0

# La web y la API comparten dominio: no hace falta FRONTEND_ORIGINS.
FRONTEND_URL=https://sanatorio.example.org

# openssl rand -base64 48
SESSION_SECRET=

# --- Réplica -----------------------------------------------------------------
# Campus que se copian en segundo plano. El resto funcionan bajo demanda.
SYNC_CAMPUS_IDS=22,37,40,46,1
DEFAULT_CAMPUS_ID=22

# Ritmo de la copia según la hora (docs/architecture.md, «Réplica de 42»). Los
# valores de fábrica son estos: no hace falta ponerlos para que funcione.
# De noche (franja en la zona horaria) y sin nadie en la web, la copia gasta
# casi toda la cuota horaria de 42 y deja SYNC_NIGHT_RESERVE (nunca menos de 40).
#SYNC_NIGHT_WINDOW=02:00-06:00
#SYNC_TIMEZONE=Europe/Madrid
#SYNC_NIGHT_RESERVE=50
# En los últimos minutos de cada hora gasta lo que sobra antes de que se pierda,
# dejando 40 + SYNC_SPEND_MARGIN para logins y para quien esté mirando.
#SYNC_SPEND_REMAINING_MINUTES=10
#SYNC_SPEND_MARGIN=30

# Logins que pueden moderar (borrar dudas, grupos y pizarras ajenas).
ADMIN_LOGINS=

# Canal de Slack del staff («incoming webhook»): los avisos de problemas del
# edificio llegan también allí, y los del despliegue (infra/scripts/deploy.sh:
# migración fallida, vuelta atrás, desplegado). Vacío, solo en la web.
SLACK_WEBHOOK_URL=

# Registro de la API: `warn` deja los 500 con su `reqId` (la cabecera
# `x-request-id`); `info` o LOG_REQUESTS=true registran cada petición.
LOG_LEVEL=warn
