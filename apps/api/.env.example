# ─────────────────────────────────────────────────────────────────────────────
# API de Sanatorio 42 — variables de entorno (desarrollo local)
#
# Copia este archivo a `.env` y rellénalo. Para producción, la plantilla es
# `infra/.env.example`. El `.env` está en el .gitignore:
# NUNCA lo subas a git.
#
# Solo hay cinco variables obligatorias: FORTY_TWO_UID, FORTY_TWO_SECRET,
# FORTY_TWO_REDIRECT_URI, SESSION_SECRET y FRONTEND_URL. Todo lo demás tiene
# valor por defecto y está comentado con su porqué.
# ─────────────────────────────────────────────────────────────────────────────

# --- API de 42 ---------------------------------------------------------------
# Client ID (UID) y Secret de tu aplicación OAuth.
# Los tienes en https://profile.intra.42.fr/oauth/applications/<TU_ID>
# El Secret es una credencial real: no lo compartas ni lo pegues en un slide.
FORTY_TWO_UID=
FORTY_TWO_SECRET=

# Raíz de la API y endpoint de token. Se declaran aquí (y no en el código)
# para poder apuntar a un servidor simulado en los tests de integración.
FORTY_TWO_API_BASE=https://api.intra.42.fr
FORTY_TWO_TOKEN_URL=https://api.intra.42.fr/oauth/token

# OBLIGATORIA. La API de 42 responde 403 a las peticiones sin User-Agent, y el
# cuerpo viene vacío, así que el error es muy confuso si no sabes esto.
FORTY_TWO_USER_AGENT=sanatorio-42/1.0

# --- Servidor ----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# --- Frontend ----------------------------------------------------------------
# A dónde vuelve la persona tras iniciar sesión.
# En producción es el mismo dominio de la API: la web y la API se sirven juntas.
FRONTEND_URL=http://localhost:5173

# Origen(es) del front a los que se permite CORS con credenciales.
# Solo hace falta en desarrollo, donde el front va en 5173 y el back en 3000.
# En producción se puede dejar vacío: se usa FRONTEND_URL.
# OJO: CORS con credenciales es incompatible con `*`. Pon la URL exacta.
FRONTEND_ORIGINS=http://localhost:5173

# --- OAuth -------------------------------------------------------------------
# Callback de OAuth. Debe estar REGISTRADA carácter a carácter en el panel de 42.
#
# En local el back escucha las rutas directamente en el puerto 3000, sin
# prefijo, así que la callback es tal cual:
#   http://localhost:3000/auth/callback
# En producción la API cuelga de /api, y la callback pública lleva el prefijo:
#   https://<tu-dominio>/api/auth/callback
FORTY_TWO_REDIRECT_URI=http://localhost:3000/auth/callback

# Scopes que se piden en la URL de autorización, separados por espacios.
# `public` da campus, proyectos y ubicaciones. `profile` es el scope de datos de
# usuario que aparece en tu panel ("manage user data") y es lo único que habilita
# /v2/me. Los scopes de escritura (projects, elearning, tig, forum) no se usan.
#
# Está en el entorno, y no en el código, a propósito: /oauth/authorize NO valida
# el scope hasta que la persona se ha autenticado, así que un nombre mal escrito
# no falla al redirigir, falla después. Cambiarlo aquí es una línea en vez de
# recompilar y redesplegar.
FORTY_TWO_SCOPES=public profile

# Clave para firmar las cookies. Mínimo 16 caracteres.
# Genera una con:  openssl rand -base64 48
#
# La sesión va DENTRO de esta cookie firmada, no en la base: esta clave es lo
# único que impide que alguien se haga pasar por otra persona.
SESSION_SECRET=

# --- Base de datos -----------------------------------------------------------
# Conexión. Un fichero SQLite (lo normal, también en producción) o un servidor
# libSQL:
#
#   file:data/sanatorio.db        fichero SQLite (por defecto)
#   libsql://…                    servidor libSQL/Turso, con DATABASE_AUTH_TOKEN
DATABASE_URL=file:data/sanatorio.db

# Token del servidor libSQL. Solo hace falta con `libsql://`.
DATABASE_AUTH_TOKEN=

# --- Réplica de la API de 42 ---------------------------------------------------
# La API limita a 2 peticiones por segundo y 1 200 por hora, y lo dice en cada
# respuesta. La web no le pregunta nada en cada visita: lee de una copia local
# que un bucle de fondo mantiene al día (ver src/modules/replica/syncer.ts).
#
# Suelo entre peticiones. 0 deja solo lo que diga la API (útil en tests).
MIN_REQUEST_INTERVAL_MS=250

# Timeout de cada petición a la API de 42.
API_TIMEOUT_MS=15000

# Intentos antes de rendirse, sin contar el primero. Solo para 429 y 5xx.
API_MAX_RETRIES=2

# Peticiones por página. El máximo de la API es 100.
PAGE_SIZE=100

# Campus que se copian en segundo plano, separados por comas. 22 es Madrid.
# Copiar un campus son ~1 600 peticiones una sola vez (unas dos horas a este
# ritmo) y después 50-130 por hora. Los demás campus funcionan bajo demanda:
# solo gastan cuando alguien los mira.
SYNC_CAMPUS_IDS=22

# Campus de quien entra sin campus principal en su perfil.
DEFAULT_CAMPUS_ID=22

# Arranca el bucle de fondo con el servidor. Ponlo a false si quieres levantar
# el back sin gastar cuota (por ejemplo, para tocar solo el front).
SYNC_ENABLED=true

# Peticiones de cada hora que el trabajo de fondo no toca nunca: son para los
# logins y para quien está usando la web.
SYNC_HOURLY_RESERVE=300

# Pausa entre dos pasos de la copia inicial, en ms. Con 5000 son 720 por hora.
SYNC_BACKFILL_INTERVAL_MS=5000

# Cada cuánto se refrescan los puestos del campus: con gente en la web / sin nadie.
LOCATIONS_TTL_SECONDS=120
LOCATIONS_IDLE_SECONDS=900

# Cada cuánto se piden los cambios de proyectos: con gente en la web / sin nadie.
DELTA_TTL_SECONDS=300
DELTA_IDLE_SECONDS=1800

# Páginas que se bajan como mucho dentro de una petición web, para lo que aún
# no esté copiado. El resto lo termina el bucle de fondo.
PEERS_PAGE_BUDGET=4

# --- Comunidad -----------------------------------------------------------------
# Logins que pueden moderar (borrar dudas, grupos y pizarras ajenas), separados
# por comas.
ADMIN_LOGINS=

# --- Web servida por la API ----------------------------------------------------
# Carpeta con la web compilada, para servirla desde este mismo proceso. Vacía en
# desarrollo (la web va con Vite). La imagen de Docker la pone sola.
STATIC_DIR=

# Registra cada petición HTTP en la salida. Útil para depurar.
LOG_REQUESTS=false
