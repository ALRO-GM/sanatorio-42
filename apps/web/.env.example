# Variables de la web. Todas tienen valor por defecto: este fichero solo hace
# falta si quieres cambiar alguno. Copia a `.env.local`.

# Dónde está la API. Por defecto `/api`: en producción es el mismo dominio y en
# desarrollo Vite lo reenvía a http://localhost:3000 (ver vite.config.ts).
VITE_API_URL=/api

# true = datos de mentira en memoria, sin API. Es lo que hace `npm run dev:mock`.
VITE_USE_MOCK=false

# Solo con datos de mentira: empieza con la sesión ya iniciada.
VITE_MOCK_LOGGED_IN=false

# Solo en desarrollo: a dónde reenvía Vite las llamadas a `/api`.
API_PROXY_TARGET=http://localhost:3000
