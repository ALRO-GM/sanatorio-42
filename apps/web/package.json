{
  "name": "@sanatorio/web",
  "version": "1.0.0",
  "description": "Web de Peer4U (antes Sanatorio 42)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit && vite build && npm run build:demo",
    "build:demo": "vite build --mode demo --base /demo/ --outDir dist/demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "textos": "tsx tools/textos-cli.ts",
    "demo:new": "tsx tools/demo-new.ts"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/dancing-script": "^5.3.0",
    "@fontsource-variable/exo-2": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@sanatorio/clicker": "*",
    "@sanatorio/course": "*",
    "@sanatorio/gitsim": "*",
    "@sanatorio/shellsim": "*",
    "chess.js": "1.4.0",
    "d3-force": "^3.0.0",
    "d3-quadtree": "^3.0.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@sanatorio/contracts": "*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-force": "^3.0.10",
    "@types/d3-quadtree": "^3.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.2",
    "vitest": "^2.1.9"
  }
}
